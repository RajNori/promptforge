# ── AI provider (server-side only; never exposed to the browser)
AI_BASE_URL=            # OpenAI-compatible base URL
AI_API_KEY=
AI_MODEL=
AI_EXTRA_BODY=          # optional JSON merged into every request, e.g. {"reasoning":{"effort":"low"}}
AI_FAST_BODY=           # optional JSON for light calls (analyze/suggest/refine), e.g. {"reasoning":{"enabled":false}}

# ── Database (Vercel Prisma Postgres integration injects this)
DATABASE_URL=

# ── Auth.js
AUTH_SECRET=            # openssl rand -base64 32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Access & ops
ADMIN_EMAILS=           # comma-separated; these accounts get Pro limits
ACCESS_CODE=            # optional shared code gate for the AI API
ALLOWED_ORIGINS=        # optional extra origins for the same-origin check (custom domains)

# ── Spend cap (site-wide, all users). Generation pauses for the rest of the UTC day once reached.
AI_DAILY_TOKEN_BUDGET=2000000   # 0 disables. Also set a hard credit limit on the provider key itself.
AI_GUEST_DAILY_LIMIT=            # Guest AI generations per day. Unset = 3. Raise it on Preview only while testing.
AI_STREAM_USAGE=                # set to 0 only if the provider rejects stream_options.include_usage

# ── Error monitoring (Sentry). Inert until the DSNs are set.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=              # optional: uploads source maps at build
SENTRY_ORG=
SENTRY_PROJECT=
